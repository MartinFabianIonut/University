<Group view="presentation" hide-input="false" hide-output="true" inline-output="false" labelreference="L26" drawlabel="true" redirect-target="L22">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal"><Equation executable="true" style="2D Input" input-equation="myPade := proc (f, m, k) local coeficienti, matriceStanga, matriceDreapta, matriceStangaVector, matriceB, p, i, j, a, b, l, rezultat; for p from 0 to m+k do coeficienti[p] := coeftayl(f(x), x = 0, p) end do; for i from -k+1 to k-1 do if m+i &lt; 0 then matriceStangaVector[i+k-1] := 0 else matriceStangaVector[i+k-1] := coeficienti[m+i] end if end do; matriceStanga := LinearAlgebra:-ToeplitzMatrix([seq(matriceStangaVector[i], i = 0 .. 2*k-2)]); matriceDreapta := `&lt;,&gt;`(seq(-coeficienti[m+i], i = 1 .. k)); matriceB := LinearAlgebra:-LinearSolve(matriceStanga, matriceDreapta); b[0] := 1; for i to k do b[i] := matriceB[i] end do; if k &lt; m then for i from k+1 to m do b[i] := 0 end do end if; for j from 0 to m do a[j] := sum(coeficienti[j-l]*b[l], l = 0 .. j) end do; rezultat := proc (x) options operator, arrow; (sum(a[l]*x^l, l = 0 .. m))/(sum(b[l]*x^l, l = 0 .. k)) end proc; return rezultat(x) end proc:" display=""></Equation></Text-field>
</Input>
</Group>
